; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deathlore"
config/features=PackedStringArray("4.1", "C#", "Mobile")
config/icon="res://ArtResources/UI/Logos/Game Logo/GameIcon06.png"

[dotnet]

project/assembly_name="Deathlore"

[editor_plugins]

enabled=PackedStringArray("res://addons/qodot/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
